<?xml version="1.0" encoding="UTF-8"?>
<!--
  Present only so the focused tests can be run (`mvn -f server/pom.xml test`).
  The exercise asks for plain Java classes rather than a runnable service, so there is no
  application framework, no HTTP layer and no persistence here.

  Targets Java 21 rather than the team's Java 25: everything used — records, sealed
  interfaces, pattern matching for switch — is available in 21, which is the widely
  installed LTS, and nothing in this excerpt would be written differently on 25.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.caseware</groupId>
    <artifactId>template-updates-domain</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
